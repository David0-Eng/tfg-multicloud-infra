# Terraform working files and state — never commit these
**/.terraform/
*.tfstate
*.tfstate.*
crash.log

# Measurement output, regenerated on every run
*.log

# Variable files with real values (may contain sensitive data)
*.tfvars
!*.tfvars.example

# Credentials / keys
.env
*.pem
*.key

# OS noise
.DS_Store
Thumbs.db
